# Settings profile for "gremlin browser run", "gremlin proxy run" and "gremlin mobile run".
#
# Copy this file to env\<name>.env and run:  gremlin browser run -e <name>
# env\default.env is picked up automatically when no -e is given.
#
# Profiles are optional, and so is every key in them: an omitted key falls back
# to the built-in default shown below. Command-line options override the profile.
#
# Format: KEY=VALUE, no spaces around "=", one setting per line.
# Lines starting with # are comments; trailing comments are not supported.
# Unknown keys are skipped with a warning; invalid values stop the script with an error.

# Optional. Start page, must start with http:// or https://
# Default: http://localhost:3001/
MITM_URL=http://localhost:3001/

# Optional. chrome | edge | full path to a Chromium-based browser exe
# Default: chrome
MITM_BROWSER=chrome

# Optional. Proxy port, 1-65535
# Default: 8080
MITM_PORT=8080

# Optional. Rules file; a relative path is resolved against the project root.
# The default file is created empty if missing; any other file must exist.
# Default: rules/rules.json
MITM_RULES=rules/rules.json

# Optional. 1 = run mitmweb (traffic UI at http://127.0.0.1:8081) instead of mitmdump
# Values: 1/0, true/false, yes/no, on/off. Default: 0
MITM_WEB=0

# Optional. 1 = ignore certificate errors in the browser (if "gremlin install" was not run)
# Values: 1/0, true/false, yes/no, on/off. Default: 0
MITM_INSECURE=0

# Optional. 1 = also run a WireGuard server, so a phone can send its traffic through the proxy
# ("gremlin mobile run" turns it on regardless). Values: 1/0, true/false, yes/no, on/off. Default: 0
MITM_WIREGUARD=0

# Optional. WireGuard UDP port, 1-65535
# Default: 51820
MITM_WG_PORT=51820
