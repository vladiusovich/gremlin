# Settings profile for "gremlin browser run", "gremlin proxy run" and "gremlin mobile run".
#
# Copy this file to profiles/<name>.env and run:  gremlin browser run --profile <name>
# (Linux: ./gremlin browser run --profile <name>)
# profiles/default.env is picked up automatically when no --profile is given.
#
# Profiles are optional, and so is every key in them: an omitted key falls back
# to the built-in default shown below. Command-line options override the profile.
#
# Format: KEY=VALUE, one setting per line. An empty value counts as not set.
# Lines starting with # are comments; trailing comments are not supported.
# Unknown keys are skipped with a warning; invalid values stop the script with an error.

# Optional. Start page, must start with http:// or https://
# Default: http://localhost:3001/
MITM_URL=http://localhost:3001/

# Optional. chrome | edge | chromium (Linux) | full path to a Chromium-based browser executable.
# On Linux chrome falls back to Chromium if Google Chrome is not installed.
# Default: chrome
MITM_BROWSER=chrome

# Optional. Proxy port, 1-65535
# Default: 8080
MITM_PORT=8080

# Optional. Rules file, when the profile should not use its own one.
# A name without .json is a file in the rules folder: trade-errors = rules/trade-errors.json,
# trade/errors = rules/trade/errors.json. A path ending in .json is resolved against the project root.
# Default: rules/<profile name>.json, e.g. rules/staging.json for profiles/staging.env;
# it is created empty if missing. Any other file must exist.
# MITM_RULES=trade-errors

# Optional. 1 = run mitmweb (traffic UI at http://127.0.0.1:8081) instead of mitmdump
# Values: 1/0, true/false, yes/no, on/off. Default: 0
MITM_WEB=0

# Optional. 1 = ignore certificate errors in the browser (if "gremlin install" was not run)
# Values: 1/0, true/false, yes/no, on/off. Default: 0
MITM_INSECURE=0

# Optional. 1 = also run a WireGuard server, so a phone can send its traffic through the proxy
# ("gremlin mobile run" turns it on regardless). Values: 1/0, true/false, yes/no, on/off. Default: 0
MITM_WIREGUARD=0

# Optional. WireGuard UDP port, 1-65535
# Default: 51820
MITM_WG_PORT=51820
